<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DazContentInstaller.ViewModels"
        x:Class="DazContentInstaller.Views.SettingsWindow"
        x:DataType="vm:SettingsWindowViewModel"
        Width="900"
        Height="800"
        MinWidth="780"
        MinHeight="680"
        Title="Settings"
        Icon="/Assets/icon.png">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Bottom"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           Classes="caption" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" Classes="secondary" />
                    <Button Content="Save" Command="{Binding SaveCommand}" Classes="primary" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="16" ColumnDefinitions="280,16,*" RowDefinitions="*">
            <Border Classes="card"
                    Grid.Column="0"
                    VerticalAlignment="Stretch">
                <Grid RowDefinitions="Auto,12,*,12,Auto">
                    <TextBlock Text="Asset Libraries" Classes="sectionTitle" />
                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding AssetLibraries}"
                             SelectedItem="{Binding SelectedAssetLibrary}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:AssetLibraryItemViewModel">
                                <Border Background="{DynamicResource SurfaceAltBrush}"
                                        CornerRadius="8"
                                        Padding="10"
                                        Margin="0,0,0,8">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Path}" TextWrapping="Wrap" Classes="caption" />
                                        <TextBlock Text="Default"
                                                   IsVisible="{Binding IsDefault}"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8">
                        <Button Content="Add" Command="{Binding AddAssetLibraryCommand}" Classes="primary" />
                        <Button Content="Remove" Command="{Binding RemoveSelectedAssetLibraryCommand}" Classes="secondary" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="2" RowDefinitions="Auto,16,*">
                <Border Classes="card" Grid.Row="0">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Library Details" Classes="sectionTitle" />
                            <TextBlock Text="Settings for the selected asset library."
                                       Classes="caption" />
                        </StackPanel>

                        <Grid ColumnDefinitions="180,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                            <TextBlock Text="Name" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding SelectedAssetLibrary.Name}" />

                            <TextBlock Grid.Row="1" Text="Path" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedAssetLibrary.Path}" />
                            <Button Grid.Row="1" Grid.Column="2" Content="Browse"
                                    Command="{Binding BrowseSelectedLibraryPathCommand}" />

                            <TextBlock Grid.Row="2" Text="Backup Path" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedAssetLibrary.ArchiveBackupPath}" />
                            <Button Grid.Row="2" Grid.Column="2" Content="Browse"
                                    Command="{Binding BrowseSelectedLibraryBackupPathCommand}" />

                            <TextBlock Grid.Row="3" Text="Thumbnail Path" VerticalAlignment="Center" />
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SelectedAssetLibrary.ArchiveThumbnailPath}" />
                            <Button Grid.Row="3" Grid.Column="2" Content="Browse"
                                    Command="{Binding BrowseSelectedLibraryThumbnailPathCommand}" />
                        </Grid>

                        <Button Content="Set Selected As Default"
                                Command="{Binding SetSelectedLibraryAsDefaultCommand}"
                                Classes="secondary"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <Border Classes="card"
                        Grid.Row="2"
                        VerticalAlignment="Stretch">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Application Settings" Classes="sectionTitle" />
                            <TextBlock Text="Global defaults and behavior for the entire application."
                                       Classes="caption" />
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <TextBlock Text="Behavior" FontWeight="SemiBold" />

                            <CheckBox Content="Auto-detect DAZ libraries on startup"
                                      IsChecked="{Binding AutoDetectDazLibraries}" />
                            <CheckBox Content="Create backup before install"
                                      IsChecked="{Binding CreateBackupBeforeInstall}" />

                            <Grid ColumnDefinitions="180,*">
                                <TextBlock Text="Max Concurrent Installs" VerticalAlignment="Center" />
                                <NumericUpDown Grid.Column="1"
                                               Minimum="1"
                                               Maximum="16"
                                               Width="120"
                                               HorizontalAlignment="Left"
                                               Value="{Binding MaxConcurrentArchiveInstalls}" />
                            </Grid>

                            <Button Content="Auto Detect Libraries"
                                    Command="{Binding AutoDetectLibrariesCommand}"
                                    Classes="secondary"
                                    HorizontalAlignment="Left" />
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Default Paths" FontWeight="SemiBold" />
                                <TextBlock Text="Used for new libraries and when a library has no override."
                                           Classes="caption" />
                            </StackPanel>

                            <Grid ColumnDefinitions="180,*,Auto" RowDefinitions="Auto,Auto,Auto">
                                <TextBlock Text="Default Backup Root" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding DefaultArchiveBackupPath}" />
                                <Button Grid.Column="2" Content="Browse"
                                        Command="{Binding BrowseDefaultArchiveBackupPathCommand}" />

                                <TextBlock Grid.Row="1" Text="Default Thumbnail Root" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DefaultArchiveThumbnailPath}" />
                                <Button Grid.Row="1" Grid.Column="2" Content="Browse"
                                        Command="{Binding BrowseDefaultArchiveThumbnailPathCommand}" />

                                <TextBlock Grid.Row="2" Text="Temp Working Path" VerticalAlignment="Center" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TempWorkingDirectoryPath}" />
                                <Button Grid.Row="2" Grid.Column="2" Content="Browse"
                                        Command="{Binding BrowseTempWorkingDirectoryPathCommand}" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
