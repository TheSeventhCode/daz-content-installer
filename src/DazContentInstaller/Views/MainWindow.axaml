<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DazContentInstaller.ViewModels"
        xmlns:models="using:DazContentInstaller.Models"
        xmlns:conv="using:DazContentInstaller.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="900"
        x:Class="DazContentInstaller.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/icon.png"
        Title="{Binding WindowTitle}"
        CanMaximize="True" CanResize="True">
    <Window.Resources>
        <conv:ArchiveStatusToBrushConverter x:Key="ArchiveStatusToBrushConverter" />
        <conv:ArchiveThumbnailConverter x:Key="ArchiveThumbnailConverter" />
        <conv:AssetTypeToBrushConverter x:Key="AssetTypeToBrushConverter" />
        <conv:CategoryToBrushConverter x:Key="CategoryToBrushConverter" />
        <conv:FileSizeConverter x:Key="FileSizeConverter" />
        <conv:FilterSegmentBackgroundConverter x:Key="FilterSegmentBackgroundConverter" />
        <conv:FilterSegmentForegroundConverter x:Key="FilterSegmentForegroundConverter" />
    </Window.Resources>

    <DockPanel Margin="16" LastChildFill="True">
        <Border DockPanel.Dock="Top" Classes="card" Padding="12" Margin="0,0,0,16">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Add Archives" Command="{Binding AddArchivesCommand}" Classes="primary" />
                    <Button Content="Install Queue" Command="{Binding InstallQueueCommand}" Classes="success" />
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" Classes="secondary" />
                    <Button Content="Uninstall Selected" Command="{Binding UninstallSelectedArchiveCommand}" Classes="danger" />
                    <Button Content="Reinstall Selected" Command="{Binding ReinstallSelectedArchiveCommand}" Classes="primary" />
                    <Button Content="Full Remove" Command="{Binding ForgetSelectedArchiveCommand}" Classes="danger" />
                    <Button Content="Settings" Click="OpenSettings_Click" Classes="secondary" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="12"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedAssetLibrarySummary}"
                               Classes="caption"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="580" />
                    <TextBlock Text="Target Library" VerticalAlignment="Center" Classes="caption" />
                    <ComboBox Width="260"
                              ItemsSource="{Binding AssetLibraries}"
                              SelectedItem="{Binding SelectedAssetLibrary}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:AssetLibraryItemViewModel">
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Classes="card statusBar"
                Classes.busy="{Binding IsBusy}"
                Classes.error="{Binding IsBlocked}"
                Padding="12"
                Margin="0,16,0,0">
            <Grid ColumnDefinitions="Auto,2*,3*" RowDefinitions="Auto,Auto">
                <Border Grid.RowSpan="2"
                        IsVisible="{Binding IsBusy}"
                        Classes="working"
                        Classes.error="{Binding IsBlocked}"
                        CornerRadius="999"
                        Padding="10,6"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="WORKING"
                               Foreground="White"
                               FontSize="11"
                               FontWeight="Bold" />
                </Border>

                <TextBlock Grid.Column="1"
                           Text="{Binding StatusText}"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock Grid.Column="1"
                           Grid.Row="1"
                           Text="{Binding ProgressPercent, StringFormat={}{0:0}%}"
                           Classes="caption"
                           IsVisible="{Binding !ShowIndeterminateProgress}" />
                <TextBlock Grid.Column="1"
                           Grid.Row="1"
                           Text="Preparing…"
                           Classes="caption"
                           IsVisible="{Binding ShowIndeterminateProgress}" />

                <ProgressBar Grid.Column="2"
                             Grid.RowSpan="2"
                             Classes="activity"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding ProgressPercent}"
                             IsIndeterminate="{Binding ShowIndeterminateProgress}"
                             Classes.error="{Binding IsBlocked}" />
            </Grid>
        </Border>

        <Grid ColumnDefinitions="1.1*,1.2*,1.7*" RowDefinitions="*">
            <Border Grid.Column="0" Classes="card" Margin="0,0,16,0">
                <Grid RowDefinitions="Auto,12,Auto,8,*,12,Auto">
                    <TextBlock Text="Installation Queue" Classes="sectionTitle" />
                    <TextBox Grid.Row="2"
                             PlaceholderText="Search queue..."
                             Text="{Binding QueueArchiveSearchText}" />
                    <ListBox Grid.Row="4"
                             ItemsSource="{Binding FilteredQueueArchives}"
                             SelectedItem="{Binding SelectedQueueArchive}"
                             SelectedItems="{Binding SelectedQueueArchives, x:CompileBindings=False}"
                             SelectionMode="Multiple">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:LoadedArchive">
                                <Border Background="{DynamicResource SurfaceAltBrush}"
                                        CornerRadius="10"
                                        Padding="10"
                                        Margin="0,0,0,10">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                            <Border Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding ArchiveStatus, Converter={StaticResource ArchiveStatusToBrushConverter}}"
                                                    CornerRadius="999"
                                                    Padding="8,4">
                                                <TextBlock Text="{Binding StatusBadgeText}"
                                                           FontSize="11"
                                                           Foreground="White"
                                                           VerticalAlignment="Center"
                                                           TextAlignment="Center" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding ScanSummary}" Classes="caption" />
                                        <ItemsControl ItemsSource="{Binding SubArchives}"
                                                      IsVisible="{Binding HasSubArchives}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:NestedArchiveSummary">
                                                    <Border Background="{DynamicResource SurfaceBrush}"
                                                            CornerRadius="8"
                                                            Padding="8"
                                                            Margin="0,0,0,6">
                                                        <StackPanel Spacing="4">
                                                            <TextBlock Text="{Binding EffectiveDisplayName}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding ArchiveName}"
                                                                       Classes="caption"
                                                                       IsVisible="{Binding HasDistinctDisplayName}" />
                                                            <TextBlock Text="{Binding Summary}" Classes="caption" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl ItemsSource="{Binding AssetTypes}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:CompileBindings="False">
                                                    <Border Background="{Binding ., Converter={StaticResource AssetTypeToBrushConverter}}"
                                                            CornerRadius="999"
                                                            Padding="8,2"
                                                            Margin="0,0,4,4">
                                                        <TextBlock Text="{Binding .}" FontSize="11" Foreground="White" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding StatusText}" Classes="caption" />
                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" />
                                        <TextBlock Text="{Binding CurrentFile}" Classes="caption" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="8">
                        <Button Content="Remove Selected"
                                Command="{Binding RemoveQueuedArchivesCommand}"
                                Classes="secondary" />
                        <Button Content="Clear"
                                Command="{Binding ClearQueueCommand}"
                                Classes="secondary" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Classes="card" Margin="0,0,16,0">
                <Grid RowDefinitions="Auto,12,Auto,8,*">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Installed Archives" Classes="sectionTitle" />
                        <Border Grid.Column="1"
                                Background="{DynamicResource SurfaceAltBrush}"
                                CornerRadius="8"
                                Padding="2">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button Content="All"
                                        Classes="filterSegment"
                                        Background="{Binding IsAllInstalledArchiveStatusFilterSelected, Converter={StaticResource FilterSegmentBackgroundConverter}, ConverterParameter=All}"
                                        Foreground="{Binding IsAllInstalledArchiveStatusFilterSelected, Converter={StaticResource FilterSegmentForegroundConverter}}"
                                        Command="{Binding SelectInstalledArchiveStatusFilterCommand}"
                                        CommandParameter="{x:Static vm:InstalledArchiveStatusFilter.All}" />
                                <Button Content="Uninstalled"
                                        Classes="filterSegment"
                                        Background="{Binding IsUninstalledInstalledArchiveStatusFilterSelected, Converter={StaticResource FilterSegmentBackgroundConverter}, ConverterParameter=Uninstalled}"
                                        Foreground="{Binding IsUninstalledInstalledArchiveStatusFilterSelected, Converter={StaticResource FilterSegmentForegroundConverter}}"
                                        Command="{Binding SelectInstalledArchiveStatusFilterCommand}"
                                        CommandParameter="{x:Static vm:InstalledArchiveStatusFilter.Uninstalled}" />
                                <Button Content="Failed"
                                        Classes="filterSegment"
                                        Background="{Binding IsFailedInstalledArchiveStatusFilterSelected, Converter={StaticResource FilterSegmentBackgroundConverter}, ConverterParameter=Failed}"
                                        Foreground="{Binding IsFailedInstalledArchiveStatusFilterSelected, Converter={StaticResource FilterSegmentForegroundConverter}}"
                                        Command="{Binding SelectInstalledArchiveStatusFilterCommand}"
                                        CommandParameter="{x:Static vm:InstalledArchiveStatusFilter.Failed}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                        <TextBox PlaceholderText="Search archives..."
                                 Text="{Binding InstalledArchiveSearchText}" />
                        <ComboBox Grid.Column="1"
                                  Margin="8,0,0,0"
                                  MinWidth="180"
                                  ItemsSource="{Binding AvailableCategoryFilters}"
                                  SelectedItem="{Binding SelectedCategoryFilter}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding ., Converter={StaticResource CategoryToBrushConverter}}"
                                            CornerRadius="999"
                                            Padding="8,4">
                                        <TextBlock Text="{Binding .}"
                                                   FontSize="11"
                                                   Foreground="White"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <Grid Grid.Row="4">
                        <ListBox ItemsSource="{Binding FilteredInstalledArchives}"
                                 SelectedItem="{Binding SelectedInstalledArchive}"
                                 SelectedItems="{Binding SelectedInstalledArchives, x:CompileBindings=False}"
                                 SelectionMode="Multiple">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:InstalledArchiveViewModel">
                                    <Border Background="{DynamicResource SurfaceAltBrush}"
                                            CornerRadius="10"
                                            Padding="10"
                                            Margin="0,0,0,10">
                                        <Grid ColumnDefinitions="84,12,*">
                                            <Border Width="84"
                                                    Height="84"
                                                    CornerRadius="8"
                                                    Background="{DynamicResource SurfaceBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    IsVisible="{Binding HasThumbnail}">
                                                <Image Source="{Binding ThumbnailPath, Converter={StaticResource ArchiveThumbnailConverter}}"
                                                       Stretch="UniformToFill" />
                                            </Border>

                                            <StackPanel Grid.Column="2" Spacing="6">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding EffectiveDisplayName}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding ArchiveName}"
                                                                   Classes="caption"
                                                                   IsVisible="{Binding HasDistinctDisplayName}" />
                                                        <TextBlock Text="{Binding AssetLibraryName}" Classes="caption" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Background="{Binding Status, Converter={StaticResource ArchiveStatusToBrushConverter}}"
                                                            CornerRadius="999"
                                                            Padding="8,4">
                                                        <TextBlock Text="{Binding Status}"
                                                                   FontSize="11"
                                                                   Foreground="White"
                                                                   VerticalAlignment="Center"
                                                                   TextAlignment="Center" />
                                                    </Border>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding AssetTypes}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:CompileBindings="False">
                                                            <Border Background="{Binding ., Converter={StaticResource AssetTypeToBrushConverter}}"
                                                                    CornerRadius="999"
                                                                    Padding="8,2"
                                                                    Margin="0,0,4,4">
                                                                <TextBlock Text="{Binding .}" FontSize="11" Foreground="White" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            <TextBlock Text="{Binding ArchiveSize, Converter={StaticResource FileSizeConverter}}" Classes="caption" />
                                            <TextBlock Text="{Binding BackupPath}" Classes="caption" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        </ListBox>
                        <Border Background="#CC11161D"
                                CornerRadius="10"
                                IsVisible="{Binding IsLoadingInstalledArchives}">
                            <StackPanel VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Spacing="12">
                                <ProgressBar IsIndeterminate="True"
                                             Width="140"
                                             Classes="activity" />
                                <TextBlock Text="Loading archives…"
                                           Classes="caption"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Classes="card">
                <Grid RowDefinitions="Auto,12,Auto,12,*">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Archive Details" Classes="sectionTitle" />
                        <Button Grid.Column="1"
                                Content="Override"
                                Click="OpenOverrides_Click"
                                Classes="secondary"
                                IsEnabled="{Binding CanOpenOverrides}"
                                IsVisible="{Binding CanOpenOverrides}" />
                    </Grid>

                    <Grid Grid.Row="2" ColumnDefinitions="Auto,12,*">
                        <Border Width="120"
                                Height="120"
                                CornerRadius="10"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Top"
                                IsVisible="{Binding SelectedInstalledArchive.HasThumbnail}">
                            <Image Source="{Binding SelectedInstalledArchive.ThumbnailPath, Converter={StaticResource ArchiveThumbnailConverter}}"
                                   Stretch="UniformToFill" />
                        </Border>

                        <Grid Grid.Column="2"
                              ColumnDefinitions="Auto,*"
                              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                            <TextBlock Text="Archive" Classes="caption" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedInstalledArchive.EffectiveDisplayName}" />

                            <TextBlock Grid.Row="1" Text="File" Classes="caption" />
                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Text="{Binding SelectedInstalledArchive.ArchiveName}"
                                       IsVisible="{Binding SelectedInstalledArchive.HasDistinctDisplayName}" />

                            <TextBlock Grid.Row="2" Text="Library" Classes="caption" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedInstalledArchive.AssetLibraryName}" />

                            <TextBlock Grid.Row="3" Text="Backup" Classes="caption" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedInstalledArchive.BackupPath}" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="4" Text="Installed" Classes="caption" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedInstalledArchive.InstalledAt}" />

                            <TextBlock Grid.Row="5" Text="Content Root" Classes="caption" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedInstalledArchive.ContentRoot}" />

                            <TextBlock Grid.Row="6" Text="Counts" Classes="caption" />
                            <StackPanel Grid.Row="6" Grid.Column="1" Spacing="4">
                                <TextBlock Text="{Binding SelectedInstalledArchive.FileCount, StringFormat='Files: {0}'}"/>
                                <TextBlock Text="{Binding SelectedInstalledArchive.OverrideCount, StringFormat='Overrides: {0}'}"
                                           Classes="caption"
                                           IsVisible="{Binding SelectedInstalledArchive.HasOverrides}" />
                            </StackPanel>

                            <TextBlock Grid.Row="7" Text="Types" Classes="caption" />
                            <ItemsControl Grid.Row="7"
                                          Grid.Column="1"
                                          ItemsSource="{Binding SelectedInstalledArchive.AssetTypes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:CompileBindings="False">
                                        <Border Background="{Binding ., Converter={StaticResource AssetTypeToBrushConverter}}"
                                                CornerRadius="999"
                                                Padding="8,2"
                                                Margin="0,0,4,4">
                                            <TextBlock Text="{Binding .}" FontSize="11" Foreground="White" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="4" RowDefinitions="Auto,8,Auto,8,*">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="Installed Files" Classes="sectionTitle" />
                            <TextBlock Text="{Binding ArchiveFileListSummary}" Classes="caption" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBox Grid.Row="2"
                                 PlaceholderText="Search files..."
                                 Text="{Binding ArchiveFileSearchText}" />

                        <ScrollViewer Grid.Row="4" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding FilteredSelectedArchiveFileGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ArchiveFileGroupViewModel">
                                        <StackPanel Spacing="8"
                                                    Margin="0,0,0,12"
                                                    HorizontalAlignment="Stretch">
                                            <Expander IsExpanded="{Binding IsExpanded}"
                                                      IsVisible="{Binding CanCollapse}"
                                                      HorizontalAlignment="Stretch"
                                                      HorizontalContentAlignment="Stretch">
                                                <Expander.Header>
                                                    <Grid HorizontalAlignment="Stretch" ColumnDefinitions="*,Auto">
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Text="{Binding EffectiveDisplayName}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding ArchiveName}"
                                                                       Classes="caption"
                                                                       IsVisible="{Binding HasDistinctDisplayName}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding FileCountSummary}"
                                                                   Classes="caption"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </Expander.Header>
                                                <ItemsControl ItemsSource="{Binding FilteredFiles}"
                                                              Margin="0,8,0,0"
                                                              HorizontalAlignment="Stretch">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:ArchiveFileRecordViewModel">
                                                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                                                    CornerRadius="8"
                                                                    Padding="10"
                                                                    Margin="0,0,0,8"
                                                                    HorizontalAlignment="Stretch">
                                                                <Grid ColumnDefinitions="*,Auto">
                                                                    <StackPanel Spacing="4">
                                                                        <TextBlock Text="{Binding InstalledRelativePath}" FontWeight="SemiBold" />
                                                                        <TextBlock Text="{Binding ArchiveRelativePath}" Classes="caption" TextWrapping="Wrap" />
                                                                        <TextBlock Text="{Binding FileSize, Converter={StaticResource FileSizeConverter}}" Classes="caption" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Right">
                                                                        <TextBlock Text="{Binding Status}" />
                                                                        <TextBlock Text="{Binding InstalledAt}" Classes="caption" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Expander>

                                            <StackPanel Spacing="8"
                                                        IsVisible="{Binding ShowRootGroupHeader}"
                                                        HorizontalAlignment="Stretch">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{Binding EffectiveDisplayName}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding ArchiveName}"
                                                                   Classes="caption"
                                                                   IsVisible="{Binding HasDistinctDisplayName}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding FileCountSummary}"
                                                               Classes="caption"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding FilteredFiles}"
                                                              HorizontalAlignment="Stretch">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:ArchiveFileRecordViewModel">
                                                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                                                    CornerRadius="8"
                                                                    Padding="10"
                                                                    Margin="0,0,0,8"
                                                                    HorizontalAlignment="Stretch">
                                                                <Grid ColumnDefinitions="*,Auto">
                                                                    <StackPanel Spacing="4">
                                                                        <TextBlock Text="{Binding InstalledRelativePath}" FontWeight="SemiBold" />
                                                                        <TextBlock Text="{Binding ArchiveRelativePath}" Classes="caption" TextWrapping="Wrap" />
                                                                        <TextBlock Text="{Binding FileSize, Converter={StaticResource FileSizeConverter}}" Classes="caption" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Right">
                                                                        <TextBlock Text="{Binding Status}" />
                                                                        <TextBlock Text="{Binding InstalledAt}" Classes="caption" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <ItemsControl ItemsSource="{Binding FilteredFiles}"
                                                          IsVisible="{Binding ShowFlatFiles}"
                                                          HorizontalAlignment="Stretch">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ArchiveFileRecordViewModel">
                                                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                                                CornerRadius="8"
                                                                Padding="10"
                                                                Margin="0,0,0,8"
                                                                HorizontalAlignment="Stretch">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <StackPanel Spacing="4">
                                                                    <TextBlock Text="{Binding InstalledRelativePath}" FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding ArchiveRelativePath}" Classes="caption" TextWrapping="Wrap" />
                                                                    <TextBlock Text="{Binding FileSize, Converter={StaticResource FileSizeConverter}}" Classes="caption" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Right">
                                                                    <TextBlock Text="{Binding Status}" />
                                                                    <TextBlock Text="{Binding InstalledAt}" Classes="caption" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
