<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#11161D"/>
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#181F29"/>
                    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#212A36"/>
                    <SolidColorBrush x:Key="BorderBrush" Color="#2B3948"/>
                    <SolidColorBrush x:Key="AccentBrush" Color="#4F7CFF"/>
                    <SolidColorBrush x:Key="SuccessBrush" Color="#4CAF50"/>
                    <SolidColorBrush x:Key="WarningBrush" Color="#C48C2A"/>
                    <SolidColorBrush x:Key="ErrorBrush" Color="#D05C5C"/>
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F5F8"/>
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A9B5C4"/>
                    <SolidColorBrush x:Key="AssetTypeCharacterBrush" Color="#6366F1"/>
                    <SolidColorBrush x:Key="AssetTypeAnatomyBrush" Color="#EC4899"/>
                    <SolidColorBrush x:Key="AssetTypeClothingBrush" Color="#8B5CF6"/>
                    <SolidColorBrush x:Key="AssetTypeHairBrush" Color="#D97706"/>
                    <SolidColorBrush x:Key="AssetTypePropsBrush" Color="#14B8A6"/>
                    <SolidColorBrush x:Key="AssetTypeEnvironmentBrush" Color="#22C55E"/>
                    <SolidColorBrush x:Key="AssetTypePosesBrush" Color="#3B82F6"/>
                    <SolidColorBrush x:Key="AssetTypeAnimationsBrush" Color="#F97316"/>
                    <SolidColorBrush x:Key="AssetTypeMaterialsBrush" Color="#A855F7"/>
                    <SolidColorBrush x:Key="AssetTypeLightsBrush" Color="#CA8A04"/>
                    <SolidColorBrush x:Key="AssetTypeCamerasBrush" Color="#06B6D4"/>
                    <SolidColorBrush x:Key="AssetTypeScriptsBrush" Color="#64748B"/>
                    <SolidColorBrush x:Key="AssetTypeTexturesBrush" Color="#E879F9"/>
                    <SolidColorBrush x:Key="AssetTypeMorphsBrush" Color="#FB7185"/>
                    <SolidColorBrush x:Key="AssetTypeUnknownBrush" Color="#7D8796"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style Selector="TextBlock.sectionTitle">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.caption">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Button.secondary">
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Button.danger">
        <Setter Property="Background" Value="{DynamicResource ErrorBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Button.success">
        <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="ProgressBar">
        <Setter Property="Height" Value="10" />
    </Style>

    <Style Selector="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="TextBox, ComboBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
    </Style>
</Styles>
